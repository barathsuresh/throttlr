<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.desertrider.throttlr.exception.GlobalExceptionHandler" level="OFF" />
    <logger name="com.desertrider.throttlr.security.ratelimit.RedisPublicRateLimitService" level="OFF" />

    <root level="WARN">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
